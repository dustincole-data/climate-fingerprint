---
// src/pages/index.astro — the gallery wall (slice 2)
import '../styles/global.css';
import FingerprintPoster from '../components/FingerprintPoster.astro';
import SearchField from '../components/SearchField.astro';
import Boot from '../components/Boot.astro';
import Controls from '../components/Controls.astro';
import { readCitiesManifest, readCityPayload, readDomain } from '../lib/data';

// Wall order = manifest order (curated registry order): max-contrast, fixed, designed — never random-per-load (T05 §gallery).
// Build-time only: payloads + domain read via node fs, marks inlined as static SVG — the browser fetches zero day-files.
const manifest = await readCitiesManifest();
const domain = await readDomain();
const cities = await Promise.all(
  manifest.map(async (entry) => ({ entry, payload: await readCityPayload(entry.slug) })),
);

const title = 'Climate Fingerprint';
// The locked lead in full — slice 2 held back "Type one in." until the search field existed (T05 §copy).
const lead = 'Every city has a climate fingerprint: the shape of its typical year. Type one in.';
const description =
  "A city's typical year as one radial signature: about thirty years of daily temperature and rainfall, averaged into one poster.";
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <Boot />
</head>
<body>
  <div class="topbar"><Controls /></div>
  <header class="masthead">
    <h1>{title}</h1>
    <p>{lead}</p>
    <SearchField />
  </header>

  <main class="wall">
    {cities.map(({ entry, payload }) => (
      <a class="tile" href={`/city/${entry.slug}`} aria-label={`${entry.name} — ${entry.signature}`}>
        <span class="poster"><FingerprintPoster payload={payload} domain={domain} mode="tile" /></span>
        <span class="cap">
          <span class="name">{entry.name}</span>
          <span class="feel">{entry.signature}</span>
        </span>
      </a>
    ))}
  </main>

  <style>
    /* The wall has no wordmark bar to hang the controls off, so they get their own quiet right-aligned row. */
    .topbar {
      display: flex;
      justify-content: flex-end;
      max-width: 1320px;
      margin: 0 auto;
      padding: 20px 24px 0;
    }

    .masthead {
      max-width: 760px;
      margin: 0 auto;
      padding: clamp(36px, 6vw, 56px) 24px 28px;
      text-align: center;
    }
    .masthead h1 {
      margin: 0;
      font-family: var(--serif);
      font-weight: 500;
      color: var(--ink);
      font-size: clamp(1.9rem, 4vw, 2.8rem);
      letter-spacing: 0.01em;
    }
    .masthead p {
      margin: 0.6rem auto 1.4rem;
      max-width: 36ch;
      font-family: var(--sans);
      color: var(--muted);
      font-size: clamp(0.95rem, 2vw, 1.06rem);
      line-height: 1.5;
    }

    /* 30 tiles = the designed ~6x5 wall (T06). Column counts are explicit, not auto-fill, so the
       max-contrast neighbor pairs land where they were composed instead of reflowing per viewport. */
    .wall {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: clamp(14px, 1.8vw, 26px);
      max-width: 1320px;
      margin: 0 auto;
      padding: 8px 24px 72px;
    }
    @media (max-width: 1200px) { .wall { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
    @media (max-width: 1000px) { .wall { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    @media (max-width: 760px)  { .wall { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @media (max-width: 520px)  { .wall { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; padding: 8px 16px 56px; } }

    .tile {
      display: block;
      text-decoration: none;
      border: 1px solid var(--hair);
      border-radius: 12px;
      overflow: hidden;
      background: var(--bg);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.18);
      transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
    }
    .poster { display: block; }
    .poster :global(svg) { display: block; width: 100%; height: auto; }

    /* Fixed-height caption box: the hover reveal animates inside it, so no tile ever grows and
       shoves its neighbours' row down (invisible at 4 tiles, a jolt across a 6-wide wall). */
    .cap {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      height: 66px;
      padding: 4px 8px;
      text-align: center;
    }
    .cap .name {
      display: block;
      font-family: var(--serif);
      font-weight: 500;
      color: var(--ink);
      font-size: 1rem;
      line-height: 1.25;
    }
    .cap .feel {
      display: block;
      max-height: 0;
      margin-top: 0;
      opacity: 0;
      overflow: hidden;
      font-family: var(--sans);
      color: var(--muted);
      font-size: 0.82rem;
      transition: max-height 0.28s ease, opacity 0.28s ease, margin-top 0.28s ease;
    }

    @media (hover: hover) {
      /* Mixed off --ink rather than a literal, so the lift still reads once the ground toggles to near-white. */
      .tile:hover {
        transform: translateY(-4px);
        border-color: color-mix(in oklab, var(--ink) 30%, transparent);
        box-shadow: 0 10px 30px color-mix(in oklab, var(--bg) 55%, transparent),
                    0 0 24px color-mix(in oklab, var(--ink) 7%, transparent);
      }
      .tile:hover .feel { max-height: 2.6em; margin-top: 3px; opacity: 1; }
    }
    .tile:focus-visible { outline: 2px solid var(--precip); outline-offset: 2px; }

    @media (prefers-reduced-motion: reduce) {
      .tile, .cap .feel { transition: none; }
      .tile:hover { transform: none; }
    }
  </style>
</body>
</html>
