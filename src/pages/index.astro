---
// src/pages/index.astro — the gallery wall (slice 2)
import '../styles/global.css';
import FingerprintPoster from '../components/FingerprintPoster.astro';
import { readCitiesManifest, readCityPayload, readDomain } from '../lib/data';

// Wall order = manifest order (curated registry order): max-contrast, fixed, designed — never random-per-load (T05 §gallery).
// Build-time only: payloads + domain read via node fs, marks inlined as static SVG — the browser fetches zero day-files.
const manifest = await readCitiesManifest();
const domain = await readDomain();
const cities = await Promise.all(
  manifest.map(async (entry) => ({ entry, payload: await readCityPayload(entry.slug) })),
);

const title = 'Climate Fingerprint';
const lead = 'Every city has a climate fingerprint: the shape of its typical year.';
const description =
  "A city's typical year as one radial signature: about thirty years of daily temperature and rainfall, averaged into one poster.";
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
</head>
<body data-ground="dark">
  <header class="masthead">
    <h1>{title}</h1>
    <p>{lead}</p>
  </header>

  <main class="wall">
    {cities.map(({ entry, payload }) => (
      <a class="tile" href={`/city/${entry.slug}`} aria-label={`${entry.name} — ${entry.signature}`}>
        <span class="poster"><FingerprintPoster payload={payload} domain={domain} ground="dark" mode="tile" /></span>
        <span class="cap">
          <span class="name">{entry.name}</span>
          <span class="feel">{entry.signature}</span>
        </span>
      </a>
    ))}
  </main>

  <style>
    .masthead {
      max-width: 760px;
      margin: 0 auto;
      padding: clamp(36px, 6vw, 56px) 24px 28px;
      text-align: center;
    }
    .masthead h1 {
      margin: 0;
      font-family: var(--serif);
      font-weight: 500;
      color: var(--ink);
      font-size: clamp(1.9rem, 4vw, 2.8rem);
      letter-spacing: 0.01em;
    }
    .masthead p {
      margin: 0.6rem auto 0;
      max-width: 36ch;
      font-family: var(--sans);
      color: var(--muted);
      font-size: clamp(0.95rem, 2vw, 1.06rem);
      line-height: 1.5;
    }

    .wall {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(16px, 2.6vw, 30px);
      max-width: 760px;
      margin: 0 auto;
      padding: 8px 24px 64px;
    }
    @media (max-width: 560px) {
      .wall { grid-template-columns: 1fr; max-width: 420px; }
    }

    .tile {
      display: block;
      text-decoration: none;
      border: 1px solid var(--hair);
      border-radius: 12px;
      overflow: hidden;
      background: var(--bg);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
      transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
    }
    .poster { display: block; }
    .poster :global(svg) { display: block; width: 100%; height: auto; }

    .cap { display: block; padding: 12px 10px 16px; text-align: center; }
    .cap .name {
      display: block;
      font-family: var(--serif);
      font-weight: 500;
      color: var(--ink);
      font-size: 1.05rem;
    }
    .cap .feel {
      display: block;
      max-height: 0;
      margin-top: 0;
      opacity: 0;
      overflow: hidden;
      font-family: var(--sans);
      color: var(--muted);
      font-size: 0.82rem;
      transition: max-height 0.28s ease, opacity 0.28s ease, margin-top 0.28s ease;
    }

    @media (hover: hover) {
      .tile:hover {
        transform: translateY(-4px);
        border-color: rgba(239, 236, 228, 0.3);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 0 24px rgba(239, 236, 228, 0.06);
      }
      .tile:hover .feel { max-height: 2.6em; margin-top: 3px; opacity: 1; }
    }
    .tile:focus-visible { outline: 2px solid var(--precip); outline-offset: 2px; }

    @media (prefers-reduced-motion: reduce) {
      .tile, .cap .feel { transition: none; }
      .tile:hover { transform: none; }
    }
  </style>
</body>
</html>
