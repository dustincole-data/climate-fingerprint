---
// src/pages/index.astro — the gallery wall (slice 2)
import '../styles/global.css';
import FingerprintPoster from '../components/FingerprintPoster.astro';
import SearchField from '../components/SearchField.astro';
import Boot from '../components/Boot.astro';
import Controls from '../components/Controls.astro';
import { readCitiesManifest, readCityPayload, readDomain } from '../lib/data';

// Wall order = manifest order (curated registry order): max-contrast, fixed, designed — never random-per-load (T05 §gallery).
// Build-time only: payloads + domain read via node fs, marks inlined as static SVG — the browser fetches zero day-files.
const manifest = await readCitiesManifest();
const domain = await readDomain();
const cities = await Promise.all(
  manifest.map(async (entry) => ({ entry, payload: await readCityPayload(entry.slug) })),
);

const title = 'Climate Fingerprint';
// The locked lead in full — slice 2 held back "Type one in." until the search field existed (T05 §copy).
const lead = 'Every city has a climate fingerprint: the shape of its typical year. Type one in.';
const description =
  "A city's typical year as one radial signature: about thirty years of daily temperature and rainfall, averaged into one poster.";
// No build-time page exists for an arbitrary (typed) city (T07), so the wall and every non-city page share
// one generic branded card rather than a per-city one (T08 §4).
const ogImage = new URL('og/_default.png', Astro.site);
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <Boot />
</head>
<body>
  <div class="topbar"><Controls /></div>
  <header class="masthead">
    <h1>{title}</h1>
    <p>{lead}</p>
    <SearchField />
  </header>

  <!-- The one property that makes a wall of these worth looking at, said once, where the comparison happens:
       every ring is drawn against the same fixed domain (T04 §1), so shape differences are real differences. -->
  <p class="wallnote">
    <span>Thirty cities on one shared scale</span>
    <span>Daily normals, 1991–2020</span>
  </p>

  <main class="wall">
    {cities.map(({ entry, payload }, i) => (
      <a class="plate" href={`/city/${entry.slug}`} aria-label={`${entry.name} — ${entry.signature}`} style={`--i:${i}`}>
        <span class="mark"><FingerprintPoster payload={payload} domain={domain} mode="tile" /></span>
        <span class="label">
          <span class="name">{entry.name}</span>
          <span class="feel">{entry.signature}</span>
        </span>
      </a>
    ))}
  </main>

  <style>
    /* The wall has no wordmark bar to hang the controls off, so they get their own quiet right-aligned row. */
    .topbar {
      display: flex;
      justify-content: flex-end;
      max-width: 1320px;
      margin: 0 auto;
      padding: 20px 24px 0;
    }

    .masthead {
      max-width: 760px;
      margin: 0 auto;
      padding: clamp(44px, 7vw, 78px) 24px 34px;
      text-align: center;
    }
    .masthead h1 {
      margin: 0;
      font-family: var(--serif);
      font-weight: 500;
      color: var(--ink);
      font-size: clamp(2.1rem, 5vw, 3.5rem);
      letter-spacing: -0.015em;
      line-height: 1.05;
      text-wrap: balance;
    }
    .masthead p {
      margin: 0.8rem auto 1.6rem;
      max-width: 46ch;
      font-family: var(--sans);
      color: var(--muted);
      font-size: clamp(0.95rem, 2vw, 1.06rem);
      line-height: 1.5;
      text-wrap: balance;
    }

    /* The frame the grid hangs off: a single hairline the whole wall aligns to, captioned on both ends. */
    .wallnote {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 20px;
      justify-content: space-between;
      max-width: 1320px;
      margin: 0 auto;
      padding: 0 24px 10px;
      border-bottom: 1px solid var(--hair);
      font-family: var(--sans);
      font-size: 0.78rem;
      color: var(--muted);
    }
    @media (max-width: 520px) {
      .wallnote { padding-inline: 16px; font-size: 0.72rem; }
    }

    /* 30 tiles = the designed ~6x5 wall (T06). Column counts are explicit, not auto-fill, so the
       max-contrast neighbor pairs land where they were composed instead of reflowing per viewport. */
    .wall {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: clamp(22px, 2.6vw, 40px) clamp(16px, 2vw, 30px);
      max-width: 1320px;
      margin: 0 auto;
      padding: clamp(26px, 3vw, 40px) 24px 88px;
    }
    @media (max-width: 1200px) { .wall { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
    @media (max-width: 1000px) { .wall { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    @media (max-width: 760px)  { .wall { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @media (max-width: 520px)  { .wall { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; padding: 8px 16px 56px; } }

    /* A plate, not a card: the rounded border, tinted fill and drop shadow that used to box each ring were
       chrome competing with the only thing worth looking at. What's left is the mark and a wall label —
       a rule, the name, and the feeling line, which is now always readable instead of hiding until hover
       (a 30-tile wall of anonymous rings is a worse trade than the extra ink). The marks carry the ground
       themselves, so nothing here paints a background and there is no seam under the label. */
    .plate { display: block; text-decoration: none; }
    .mark {
      display: block;
      transition: transform 0.34s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .mark :global(svg) { display: block; width: 100%; height: auto; }

    .label {
      display: block;
      margin-top: 10px;
      padding-top: 9px;
      border-top: 1px solid var(--hair);
      transition: border-color 0.34s ease;
    }
    .label .name {
      display: block;
      font-family: var(--serif);
      font-weight: 500;
      color: var(--ink);
      font-size: 1rem;
      line-height: 1.2;
    }
    .label .feel {
      display: block;
      margin-top: 3px;
      font-family: var(--sans);
      color: var(--muted);
      font-size: 0.78rem;
      line-height: 1.35;
      text-wrap: pretty;
    }

    @media (hover: hover) {
      /* Mixed off --ink rather than a literal, so the lift still reads once the ground toggles to near-white. */
      .plate:hover .mark { transform: translateY(-5px); }
      .plate:hover .label { border-color: color-mix(in oklab, var(--ink) 45%, transparent); }
    }
    .plate:focus-visible { outline: 2px solid var(--precip); outline-offset: 6px; }

    /* Arrival: the wall develops the way a single poster does, one plate behind the next. `backwards` is what
       keeps it a reveal rather than a gate — the animation always runs and always ends on the visible state. */
    @keyframes plate-in {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: none; }
    }
    @media (prefers-reduced-motion: no-preference) {
      .plate {
        animation: plate-in 620ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
        animation-delay: calc(var(--i) * 18ms);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .mark, .label { transition: none; }
      .plate:hover .mark { transform: none; }
    }
  </style>
</body>
</html>
