---
// src/components/FingerprintPoster.astro
// Thin wrapper over src/lib/render.ts — the markup itself lives there so the on-demand client shell
// renders typed cities through the identical code path (T07 §1).
import type { CityPayload, Domain } from '../lib/types';
import { renderPosterSvg } from '../lib/render';

interface Props { payload: CityPayload; domain: Domain; ground?: 'dark' | 'light'; mode?: 'full' | 'tile'; }
const { payload, domain, ground = 'dark', mode = 'full' } = Astro.props as Props;
const svg = renderPosterSvg(payload, domain, { ground, mode });
---
<Fragment set:html={svg} />
